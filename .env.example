# Production Environment Configuration
# ==================================

# Build Information
BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
VCS_REF=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
VERSION=1.0.0

# Environment
ENVIRONMENT=production
APP_NAME="Locker Phycer"
DEBUG=false

# Security Keys (Generate new ones for production)
SECRET_KEY=
AI_CITIZENSHIP_SECRET=
ENCRYPTION_KEY=

# Database Configuration
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lockerphycer_user:@postgres:5432/lockerphycer_production

# Redis Configuration
REDIS_PASSWORD=
REDIS_URL=redis://:redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password@redis:6379/0

# Application URLs
API_HOST_PORT=8092
PORT=8092
FRONTEND_URL=https://veklom.com
API_URL=https://command.veklom.com
CAPI_BACKEND_URL=http://capi-container:3003
CAPI_API_KEY=
CAPPO_BACKEND_URL=
PGL_LEDGER_URL=
BYOS_MCP_GATEWAY_URL=

# AI inference endpoint
OLLAMA_BASE_URL=

# AI Provider Keys
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=

# Billing & Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Veklom Wallet on Base (core/wallet/config.py). No keys: the treasury is a
# receive-only address and every RPC call is read-only.
# base-sepolia (default, testnet, chain 84532) | base (mainnet, chain 8453)
WALLET_NETWORK=base-sepolia
# Optional dedicated Base RPC; empty uses the public endpoint for WALLET_NETWORK.
WALLET_RPC_URL=
# Address that onchain (USDC) top-ups are sent to. Empty disables onchain top-ups.
WALLET_TREASURY_ADDRESS=
# Hosts accepted as the SIWE "domain" (comma-separated). Empty = host of FRONTEND_URL.
WALLET_SIWE_DOMAINS=
WALLET_MIN_CONFIRMATIONS=3

# Monitoring — Sentry Error Tracking & Performance
# ─────────────────────────────────────────────────
# REQUIRED for Sentry to activate.  Without this the SDK is a silent no-op.
# 1. Go to https://sentry.io → Settings → Projects → <your project> → Client Keys (DSN)
# 2. Copy the DSN (format: https://xxx@oXXX.ingest.sentry.io/XXXX)
# 3. Paste it below.
# traces_sample_rate is hardcoded to 1.0 in main.py — lower it (e.g. 0.1) in
# high-traffic production once you have a baseline in the Performance tab.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Grafana / Prometheus
GRAFANA_PASSWORD=

# Provider-neutral transactional email. Select a qualified relay profile from
# docs/email-provider-profiles.md; never commit real credentials.
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Veklom <noreply@auth.veklom.com>"

# Primary SMTP relay
# Keep the application provider-neutral; only these environment values are provider-specific.
# Live (release/20260930): Cloudflare Email Service over authenticated SMTP.
# SMTP_PASSWORD is a Cloudflare API token with Email Sending permission.
# Alternative candidate: Resend SMTP on the separately verified auth.veklom.com subdomain
# (SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_SSL=true SMTP_TLS=false).
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=true
SMTP_TIMEOUT_SECONDS=15

# Independent fallback SMTP relay
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_TLS=true
SMTP_FALLBACK_SSL=false

# Storage Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Security Settings
ENABLE_MFA=true
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=120

# Performance Settings
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

# AI/ML Configuration
MODEL_CACHE_DIR=/app/models
MAX_CONCURRENT_AI_REQUESTS=10
AI_REQUEST_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/lockerphycer.log

# OpenTelemetry / Grafana Cloud Application Observability
OTEL_SERVICE_NAME=veklom-sovereign-ai-hub
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded-instanceID:apiKey>
